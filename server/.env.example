# =============================================================================
# Applications service - environment
# Copy to .env and fill in. Never commit the real file.
# =============================================================================

# --- Django ---------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Comma separated. The hostname this service answers on.
DJANGO_ALLOWED_HOSTS=apply.example.org
# Origins allowed to post the form here. The public Netlify site.
PUBLIC_SITE_ORIGINS=https://dev-comm.netlify.app
CSRF_TRUSTED_ORIGINS=https://apply.example.org
PUBLIC_SITE_URL=https://dev-comm.netlify.app

# --- Database -------------------------------------------------------------
POSTGRES_DB=kdu
POSTGRES_USER=kdu
POSTGRES_PASSWORD=
DATABASE_URL=postgres://kdu:CHANGE_ME@db:5432/kdu

# --- Email ----------------------------------------------------------------
# Same names the Netlify function used. See the main README for how to
# generate a Google App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
TEAM_INBOX=
GMAIL_SMTP_PORT=465

# --- Optional -------------------------------------------------------------
GUNICORN_WORKERS=2
DJANGO_LOG_LEVEL=INFO
