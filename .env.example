# =============================================================================
# KDU Developer Community — environment variables
# -----------------------------------------------------------------------------
# Copy this file to .env for local development (`netlify dev` loads it), and set
# the same names in the Netlify dashboard for production:
#   Site configuration -> Environment variables -> Add a variable
#
# NEVER commit the real values. .env is listed in .gitignore.
# =============================================================================

# The Gmail address the site sends mail FROM.
GMAIL_USER=kdu.dev.community@gmail.com

# A Google App Password for that account - 16 characters, NOT the account
# password. Generate one at https://myaccount.google.com/apppasswords
# (2-Step Verification must be switched on first). See README.md.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional. Where notifications about new submissions are delivered.
# Defaults to GMAIL_USER if left unset.
TEAM_INBOX=kdu.dev.community@gmail.com

# Optional. 465 (implicit TLS, the default) or 587 (STARTTLS).
GMAIL_SMTP_PORT=465
